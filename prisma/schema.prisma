generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums; status is validated in the API (PENDING | COMPLETED | FAILED).
model Receipt {
  id        String   @id @default(uuid())
  message   String   @default("hi this is a demo app")
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
